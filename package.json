{
  "name": "@azulores/koishi-plugin-wordle",
  "description": "Wordle 猜单词游戏 for Koishi：图片棋盘 + QWERTY 键盘，支持指定字母数、自定义词库与提示语",
  "version": "1.0.2",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "dist"
  ],
  "license": "MIT",
  "author": "yiyikneesocks",
  "keywords": [
    "chatbot",
    "koishi",
    "plugin",
    "wordle",
    "game"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/tiku.txt','lib/tiku.txt');require('fs').copyFileSync('src/djciku.txt','lib/djciku.txt')\""
  },
  "peerDependencies": {
    "koishi": "^4.18.11"
  },
  "peerDependenciesMeta": {
    "koishi-plugin-puppeteer": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yiyikneesocks/koishi-plugin-wordle.git"
  },
  "bugs": {
    "url": "https://github.com/yiyikneesocks/koishi-plugin-wordle/issues"
  },
  "homepage": "https://github.com/yiyikneesocks/koishi-plugin-wordle#readme"
}
